{
  "name": "QuickJob",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "usages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spool_id": {
            "type": "string"
          },
          "spool_label": {
            "type": "string"
          },
          "spool_color_hex": {
            "type": "string"
          },
          "grams": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "usages"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}