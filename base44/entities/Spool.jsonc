{
  "name": "Spool",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "color_name": {
      "type": "string"
    },
    "color_type": {
      "type": "string",
      "enum": [
        "single",
        "multi",
        "rainbow"
      ],
      "default": "single"
    },
    "color_hex": {
      "type": "string"
    },
    "color_hex_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "starting_weight_grams": {
      "type": "number"
    },
    "current_weight_grams": {
      "type": "number"
    },
    "purchase_price_per_kg": {
      "type": "number"
    },
    "printer_slot": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "date_opened": {
      "type": "string",
      "format": "date"
    },
    "is_empty": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "material",
    "color_name",
    "starting_weight_grams",
    "current_weight_grams"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}